# 首次启动复制为 .env；make 会加载。两个 Go 服务必须使用相同的管理库、审计库和允许目录。
MANAGEMENT_DB_PATH=data/management.db
AUDIT_DB_PATH=data/audit.db
# MCP 持有 Action 内存回执，API 通过本地 IPC 访问；两个服务必须一致。
ACTION_STATE_SOCKET=data/runtime/actions.sock
ADMIN_USERNAME=admin
# 仅初始化第一个管理员时使用，至少 6 字符。账号建立后在控制台重置密码。
ADMIN_PASSWORD=
# 允许登记业务 SQLite 的服务端目录；多个目录用系统路径分隔符分开（macOS/Linux 为 :）。
DATABASE_ALLOWED_ROOTS=data

# 首次导入演示库；仅使用网络数据库时设置为空（两个 Go 服务均支持空库启动）。
SQLITE_PATH=data/securities_demo.sqlite3
# 管理端可直接输入数据库密码并加密保存，无需配置以下变量。
# 兼容旧环境变量引用：按需取消注释；API 与 MCP 使用相同的值。
# DATASCOPE_DB_MYSQL_PASSWORD=
# DATASCOPE_DB_POSTGRESQL_PASSWORD=
# DATASCOPE_DB_ORACLE_PASSWORD=
# DATASCOPE_DB_DAMENG_PASSWORD=
QUERY_TIMEOUT=10s
# 管理 API 自动侦查结构变化的间隔；0s 关闭定时侦查（仍可手动扫描）。
DISCOVERY_INTERVAL=5m
REWRITE_CONFIG=config/rewrite.yml
REWRITE_AS_OF=2026-10-21T00:00:00Z
# 以下配置仅空环境首次导入数据源时使用；之后使用 data/databases/<ID>/management/ YAML。
DATABASE_CONFIG_DIR=config/databases
DATABASE_CATALOG=data/databases.json

# 业务 MCP 使用 HTTP OAuth，按 /mcp/{mcp_path} 选择数据库。
MCP_DATABASE=default
# 管理端业务 MCP 使用 oauth；header / none 仅用于底层独立演示测试。
MCP_AUTH_MODE=oauth
MCP_USER_HEADER=X-User-Id
MCP_DEFAULT_USER_ID=
MCP_TRANSPORT=http
SERVER_ADDR=127.0.0.1:8080
MCP_PATH=/mcp
MCP_RESOURCE_URL=http://127.0.0.1:8080/mcp
MCP_STATELESS=true
MCP_DEBUG=false

# 管理认证使用平台根 issuer；业务认证按数据库配置选择独立账号域。外部访问配置 HTTPS。
# 证券 demo 员工模拟账号的首次初始化密码（至少 6 字符），初始化后不覆盖已有密码。
OAUTH_DEMO_PASSWORD=
OAUTH_ISSUER=http://127.0.0.1:8081
OAUTH_KEY_PATH=data/oauth/signing.pem
# 旧状态库迁移来源：保留客户端注册；旧员工授权需要重新登录。
OAUTH_STATE_PATH=data/oauth/state.sqlite3
# HTTPS 反向代理部署时设为 true（默认根据 OAUTH_ISSUER 的 https 协议判断）。
# SESSION_COOKIE_SECURE=true

ADMIN_API_ADDR=127.0.0.1:8081
MCP_SERVER_URL=http://127.0.0.1:8080/mcp
FIXTURES_DIR=fixtures
WEB_PORT=8082
ADMIN_API_URL=http://127.0.0.1:8081
# 浏览器登录成功后的 Web 地址；企业 OAuth 的 Web 回调也使用此公开地址。
WEB_PUBLIC_URL=http://127.0.0.1:8082
# 企业认证提供方通过全局认证界面配置，密钥仅从服务端环境变量读取。
# DATASCOPE_AUTH_ENTERPRISE_SECRET=
